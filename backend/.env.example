# Αντίγραψε αυτό το αρχείο σε .env και βάλε τις δικές σου τιμές.

# Με τοπικό Prisma Postgres (npx prisma dev) βάλε εδώ τις δύο τιμές που τυπώνει η εντολή.
# Με κανονική PostgreSQL βάλε το ίδιο URL και στις δύο μεταβλητές, π.χ.
# postgresql://postgres:postgres@localhost:5432/eventmanager
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventmanager"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventmanager"

# Μυστικό κλειδί για την υπογραφή των JWT.
JWT_SECRET="change-me-to-a-long-random-string"

PORT=3000
